        +reporteCompleto() ReporteFinanciero
        +resumenOperativo() ResumenOperativo
        +invalidarCache()
        +auditoria() List
        -autenticar() UsuarioSesion
        -objetoReal() ServicioReportes
    }
    class ServicioReportesReal {
        +reporteCompleto() ReporteFinanciero
        +resumenOperativo() ResumenOperativo
    }
    class ReporteController
    class ProveedorUsuarioActual {
        <<interface>>
        +actual() Optional
    }
    class VerificadorCredenciales {
        <<interface>>
        +esValido(UsuarioSesion) boolean
    }
    ReporteController --> ServicioReportes : solo conoce la interfaz
    ServicioReportes <|.. ProxyServicioReportes
